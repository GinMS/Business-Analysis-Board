# Firebase web app config — copy this file to ".env" and fill in your values.
# Get them from: Firebase Console → Project settings → General → Your apps → SDK setup and configuration.
# These are NOT secrets; they only identify your project to Google.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — restrict who can sign in. Leave both blank to allow any Google account.
# VITE_ALLOWED_EMAILS=you@example.com,teammate@example.com
# VITE_ALLOWED_DOMAIN=yourcompany.com
